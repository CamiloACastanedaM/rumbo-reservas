# Copiar a backend/.env y ajustar. Valores de ejemplo, no reales.
DB_URL=jdbc:mysql://localhost:3306/rumbo
DB_USERNAME=rumbo
DB_PASSWORD=rumbo
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Clave para firmar los JWT: 32 caracteres o más. Genera una propia.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria-0123456789
# Primer administrador (se crea al arrancar si no existe).
ADMIN_EMAIL=admin@rumbo.local
ADMIN_PASSWORD=Cambiar123
# SMTP local de Mailpit (bandeja en http://localhost:8025).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=Rumbo <no-responder@rumbo.local>
